# ============================================
# DeepTutor — School Deployment Environment
# ============================================
# Copy this file to .env.school and fill in the values below before
# running `docker compose -f docker-compose.school.yml up -d`.
#
# Secrets marked [REQUIRED] must be set — the stack will refuse to start
# otherwise. All other values have sensible defaults for a single-school
# deployment.
# ============================================

# --------------------------------------------
# Database (PostgreSQL)
# --------------------------------------------
POSTGRES_DB=deeptutor
POSTGRES_USER=deeptutor
# [REQUIRED] Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --------------------------------------------
# JWT signing secret
# --------------------------------------------
# [REQUIRED] Generate with: openssl rand -base64 48
# Keep this stable across restarts — changing it invalidates all
# existing student/teacher sessions.
DEEPTUTOR_JWT_SECRET=change-me-to-a-random-48-byte-string

# --------------------------------------------
# LLM (served by bundled Ollama container)
# --------------------------------------------
# Recommended models:
#   qwen2.5:14b   → best quality, requires ~10GB VRAM (16GB recommended)
#   qwen2.5:7b    → good quality, runs on 8GB VRAM or CPU
#   llama3.1:8b   → alternative English-first model
LLM_MODEL=qwen2.5:14b

# Embedding model (also served by Ollama):
#   nomic-embed-text       → 768 dims, CPU-friendly, good general use
#   mxbai-embed-large      → 1024 dims, higher quality, slower
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --------------------------------------------
# Service ports
# --------------------------------------------
BACKEND_PORT=8001
FRONTEND_PORT=3782

# If students and teachers access the server from other machines on the
# school network, set this to the server's LAN address, e.g.:
#   NEXT_PUBLIC_API_BASE_EXTERNAL=http://192.168.1.10:8001
NEXT_PUBLIC_API_BASE_EXTERNAL=

# --------------------------------------------
# Image selection
# --------------------------------------------
# Pin to a specific version in production — do not rely on :latest.
DEEPTUTOR_IMAGE=ghcr.io/hkuds/deeptutor:latest

# --------------------------------------------
# Backups
# --------------------------------------------
# Daily at midnight by default. See https://crontab.guru for other
# schedules. Leaving retention values high is safe — pg_dump output is
# highly compressible.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
